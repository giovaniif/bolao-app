# In EAS builds, set these as EAS environment variables.
# Sentry: use the bolao-mobile project DSN (never the bolao-api or bolao-web one).
EXPO_PUBLIC_SENTRY_DSN=
# dev | preview | production
EXPO_PUBLIC_SENTRY_ENVIRONMENT=dev
# EAS secret only, never commit: SENTRY_AUTH_TOKEN (uploads dSYMs and source maps).
