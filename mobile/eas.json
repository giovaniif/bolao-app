{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bolao-api-dev-1030775803263.us-central1.run.app/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bolao-api-dev-1030775803263.us-central1.run.app/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.bolao.giovani.sh/api"
      }
    },
    "testflight-dev": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bolao-api-dev-1030775803263.us-central1.run.app/api"
      },
      "environment": "preview"
    },
    "play-internal": {
      "extends": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6825092951",
        "appleTeamId": "827UMZ89C2"
      }
    },
    "testflight-dev": {
      "extends": "production"
    }
  }
}
