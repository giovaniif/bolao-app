{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bolao-app-dev.onrender.com/api"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bolao-app-dev.onrender.com/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bolao-app-mcc8.onrender.com/api"
      }
    },
    "testflight-dev": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bolao-app-dev.onrender.com/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6825092951",
        "appleTeamId": "827UMZ89C2"
      }
    },
    "testflight-dev": {
      "extends": "production"
    }
  }
}
